---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
---
<Base title="Pagina niet gevonden | TodayOnline">
  <main class="wrap">
    <article class="legal">
      <p class="mono chap"><i></i>404</p>
      <h1>Deze pagina bestaat niet (meer).</h1>
      <p class="lede">De website is vernieuwd. Alles staat nu op één pagina.</p>
      <p><a class="btn btn-primary" href="/">Naar de homepage <span class="arr" aria-hidden="true">→</span></a></p>
    </article>
  </main>
  <div class="on-brand"><Footer /></div>
</Base>
