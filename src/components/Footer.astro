---
import { SITE } from "../data/site.js";
const year = new Date().getFullYear();
---
<footer class="wrap"><div class="ftr mono">
  <span>2019 – {year} | {SITE.name}</span>
  <span>
    {SITE.socials.map(([label, href]) => <a href={href} target="_blank" rel="noopener">{label}</a>)}
    <a href="/privacy/">Privacy</a>
    <a href="/disclaimer/">Disclaimer</a>
  </span>
</div></footer>
